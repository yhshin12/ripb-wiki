#!/bin/bash
# Phase 0 관문 (spec §3.3): 원문·내부 경로는 공개 저장소에 들어오지 못한다.
staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
done < <(git -c core.quotepath=false diff --cached --name-only -z --diff-filter=ACMR)

bad=()
shopt -s nocasematch
for f in "${staged[@]}"; do
  case "$f" in
    references/*|internal/*|inbox/*|raw/*) bad+=("$f") ;;
  esac
done
if [ "${#bad[@]}" -gt 0 ]; then
  echo "pre-commit: refused (local-only paths):"
  printf '%s\n' "${bad[@]}"
  exit 1
fi

# 공개 노트는 내부 노트로 링크하지 않는다.
hits=()
for f in "${staged[@]}"; do
  case "$f" in
    wiki/*.md)
      while IFS= read -r line; do
        hits+=("$line")
      done < <(git diff --cached --no-color --no-ext-diff -U0 -- "$f" | awk 'h && substr($0,1,1)=="+" {print; next} /^@@/ {h=1}' | grep -F '[[HSFR_')
      ;;
  esac
done
if [ "${#hits[@]}" -gt 0 ]; then
  echo "pre-commit: refused ([[HSFR_ link in a public note):"
  printf '%s\n' "${hits[@]}"
  exit 1
fi

# 공개 커밋의 추가 줄·경로에 내부 문서명이 없어야 한다 (spec §8.2, R14).
PY="${RIPB_PY:-/c/Code/Python/pykaeri/.venv12/Scripts/python.exe}"
ROOT="$(git rev-parse --show-toplevel)"
if ! "$PY" "$ROOT/scripts/leak_guard.py" --staged; then
  echo "pre-commit: refused (internal document names; see above)"
  exit 1
fi

# 전체 검사 (spec §8.2). 작업 트리를 검사하므로 일부만 stage한 경우에도 전체 기준으로 판정된다.
for check in "lint_wiki.py --all" "verify_quotes.py --all" "build_index.py --check"; do
  if ! out=$("$PY" "$ROOT/scripts/"$check 2>&1); then
    printf '%s\n' "$out"
    echo "pre-commit: refused ($check)"
    exit 1
  fi
done
exit 0
